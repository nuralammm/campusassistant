# Copy to .env locally; never commit .env. Pass --env-file .env to uvicorn.
DATABASE_URL=sqlite:///./campus.db
AI_PROVIDER=disabled
AI_MODEL=
OLLAMA_URL=http://127.0.0.1:11434
OPENAI_API_KEY=
AI_INPUT_IDR_PER_MILLION=0
AI_OUTPUT_IDR_PER_MILLION=0
AI_MAX_OUTPUT_TOKENS=800
AI_MAX_RUN_IDR=5000
AI_MONTHLY_CLASS_IDR=100000
AGENT_DISABLED=0
